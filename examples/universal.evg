// The theorem stores one bound index, regardless of the size of its domain.
fn main() -> usize {
    fact bounded = forall(i: integer) where (0 <= i && i < 10) {
        i <= 9
    };
    proof range: bounded by {
        intro i;
        omega
    };

    let index: usize = 7;
    proof selected: integer(index) <= 9 by {
        specialize range(index);
        omega // Establish the specialized domain: 0 <= index && index < 10.
    };
    42
}
