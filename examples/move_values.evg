// Move-only values do not need a destructor.
type Permit struct {tag: usize}
type Envelope struct {permit: Permit}

fn transfer(p: Permit) -> Permit ensures (result.tag == p.tag) {p}
fn consume(p: Permit) -> usize ensures (result == p.tag) {p.tag}

// Proof-only values obey the same move rules.
ideal type Ticket struct {tag: nat}
ideal fn forward(t: Ticket) -> Ticket ensures (result.tag == t.tag) {t}
ideal fn use_ticket() -> nat ensures (result == 7) {
    let t = Ticket {tag: 7};
    let next = forward(t);
    next.tag
}

fn main() -> usize ensures (result == 42) {
    let p = Permit {tag: 42};
    let q = transfer(p);
    // Reading a scalar field borrows the storage; passing q transfers it.
    proof tag: q.tag == 42;
    consume(q)
}
