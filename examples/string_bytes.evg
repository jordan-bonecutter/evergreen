// A literal has a fixed byte-array type, including its UTF-8 byte extent.
fn first(
    ideal n: nat,
    bytes: &[u8; n]
) -> u8
    where
        n > 0
{
    (*bytes)[0]
}
fn empty(
    bytes: &[u8; 0]
) -> usize {
    42
}

fn main() -> usize {
    let text = "λ🦀\n";
    proof encoding: text[0] == 206 && text[1] == 187 && text[6] == 10;
    let nothing = "";
    let answer = empty(&nothing);
    if first(&"*") == 42 {answer} else {1}
}
