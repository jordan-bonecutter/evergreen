type Guard struct {target: &usize, value: usize}
impl Drop for Guard {
    fn drop(self)
        modifies(self.target)
        ensures
            (*self.target == self.value)
    {
        *self.target = self.value;
    }
}
fn finish() -> unique(usize)
    ensures
        (*result == 42)
{
    let owner: unique(usize) = alloc(7);
    let guard = Guard {target: &*owner, value: 42};
    owner
}
fn main() -> usize {
    let owner = finish();
    *owner
}
