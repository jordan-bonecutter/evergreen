type MyPair<T> struct {
    data: [T; 2]
} where data[0] < data[1];

impl<T> MyPair<T> {
    fn new(x: T, y: T) -> Self
        where
            x < y
        ensures
            result.data[0] == x &&
            result.data[1] == y
    {
        Self {data: [x, y]}
    }
}

fn add_to_both(x: &usize, y: &usize)
    where
        *x < usize::MAX &&
        *y <= usize::MAX - 2
    modifies(x, y)
    ensures
        (*x == old(*x) + 1 &&
        *y == old(*y) + 2)
{
    *x = *x + 1;
    *y = *y + 2;
}

fn main() -> isize {
    let x = MyPair::<usize>::new(0, 1);
    add_to_both(&x.data[0], &x.data[1]);
    0
}
