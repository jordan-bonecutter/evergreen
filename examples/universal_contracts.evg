type Bounds struct {limit: usize}
fn establish(b: &Bounds)
    modifies(&b.limit)
    ensures
        (forall(i: integer) where (0 <= i &&
        i < 4) {i < integer(b.limit)})
{
    b.limit = 46;
}

fn require(b: &Bounds) -> usize
    where
        (forall(i: integer) where (0 <= i &&
        i < 4) {i < integer(b.limit)})
{
    // Give the imported guarantee a name for explicit specialization.
    proof bounds:
        forall(i: integer) where (0 <= i &&
        i < 4) {i < integer(b.limit)} by {assumption};
    proof lower_bound:
        3 < integer(b.limit) by {
            specialize bounds(3);
            omega
        };
    b.limit - 4
}

fn main() -> usize {
    let b = Bounds {limit: 0};
    establish(&b);

    let cursor: usize = 0;
    while cursor < 4
        invariant
            (
                cursor <= 4 &&
                (forall(i: integer)
                where (
                    0 <= i &&
                    i < 4
                ) {i < integer(b.limit)})
            )
        modifies(&cursor)
        decreases(4 - cursor)
    {
        cursor = cursor + 1;
    }

    // Changing b.limit here would require proving the precondition again.
    require(&b)
}
