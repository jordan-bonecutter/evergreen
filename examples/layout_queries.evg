// Layout queries observe target storage without constructing a value.
type Header struct {tag: u8, length: usize}
type Huge struct {
    data: [u8; 1000000000],
    tag: usize
}

fn byte_count<T>(count: usize) -> usize
    where
        integer(count) * integer(size_of(T)) <= integer(isize::MAX)
    ensures
        result == count * size_of(T)
{
    count * size_of(T)
}

fn main() -> usize {
    proof _: size_of(u8) == 1 && size_of(Header) == 16;
    if size_of(Huge) == 1000000008 && align_of(Header) == 8 {byte_count::<u16>(21)} else {1}
}
