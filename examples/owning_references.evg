// Generic lifetime capabilities: no compiler-defined Rc counter or destructor.
fn main() -> usize {
    let allocation: unique(usize) = alloc(42);
    let first: shared(usize) = move(allocation);
    proof initially_unique: owner_count(first) == 1;
    let second = first;
    proof shared: owner_count(first) == 2;
    leak(first);
    proof unique_again: owner_count(second) == 1;
    let unique: unique(usize) = move(second);
    *unique
}
