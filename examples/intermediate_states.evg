type Pair struct {
    left: usize,
    right: usize,
} where (fact balanced = left == right; balanced);

fn observe(pair: &Pair) -> usize ensures (result == (*pair).left) {
    (*pair).left
}

fn main() -> usize ensures (result == 42) {
    let pair = Pair { left: 1, right: 1 };
    let reference = &pair;
    update(pair) lifts balanced {
        pair.left = 42;
        // The whole-pair invariant is unavailable until the update closes.
        pair.right = pair.left;
    }
    // Closing the update proves Pair again; its storage was never moved.
    observe(reference)
}
