type Pair struct {
    left: usize,
    right: usize,
} where (left == right);

fn observe(pair: &Pair) -> usize ensures (result == (*pair).left) {
    (*pair).left
}

fn main() -> usize ensures (result == 42) {
    let pair = Pair { left: 1, right: 1 };
    let reference = &pair;
    update (pair) {
        pair.left = 42;
        // The invariant is open here. Calls and borrowing are forbidden.
        pair.right = pair.left;
    }
    // Closing the update proves Pair again; its storage was never moved.
    observe(reference)
}
