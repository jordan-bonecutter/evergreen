fn as_ref<T>(slot: &(T | shape(T))) -> &T
    where
        typeof(*slot) == T
    borrows(slot)
{
    slot
}

fn main() -> usize {
    let buffer: unique(unique(usize) | shape(unique(usize)), 8) = alloc(8, shape(unique(usize)));
    (*buffer)[3] = alloc(42);

    let view = as_ref::<unique(usize)>(&(*buffer)[3]);
    let payload = &**view;
    let value: unique(usize) = (*buffer)[3];

    // The slot's type is now shape(unique(usize)); reading view would fail.
    // payload names the separate allocation still owned by value.
    let empty: unique(shape(unique(usize)), 8) = buffer;
    drop(empty);
    *payload
}
