// The credits are backed by this allocation, unlike standalone numeric budgets.
// No runtime reference counter is implemented by this example or the compiler.
fn main() -> usize {
    let allocation: plane(usize) = alloc(42);
    let view = &*allocation;
    let first = allocation_credits::attach(allocation);
    let second = allocation_credits::duplicate(&first);
    proof shared: allocation_credits::outstanding(&first) == 2;
    proof same_target: allocation_credits::target(&first) == view
        && allocation_credits::target(&second) == view;

    let sole = allocation_credits::merge(first, second);
    proof unique: allocation_credits::outstanding(&sole) == 1;
    let recovered = allocation_credits::recover(sole);
    proof stable_plane: &*recovered == view;
    *view
}
