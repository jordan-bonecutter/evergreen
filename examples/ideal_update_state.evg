type Ledger struct {count: &usize, owners: usize} where (
    fact accurate = *count == owners;
    fact zero_is_safe = *count == 0 =>
    owners == 0;
    accurate &&
    zero_is_safe
);

fn copied_array() -> usize
    ensures
        (result == 42)
{
    let data: [usize; 2] = [7, 9];
    ideal let snapshot = data;
    ideal snapshot[0] = 42;
    proof original: data[0] == 7;
    proof changed_copy: snapshot[0] == 42;
    data[0] + 35
}

fn main() -> usize
    ensures
        (result == 42)
{
    let count: usize = 41;
    let ledger = Ledger {count: &count, owners: 41};
    ideal let expected = nat(count);
    update(ledger) lifts accurate {
        ideal let updated = expected + 1;
        ledger.owners = 42;
        count = 42;
        ideal expected = updated;
    }
    proof agrees:
        expected == nat(count);
        // The ideal local's scope is over; this is an ordinary runtime binding.
    let updated: usize = 0;
    let copied = copied_array();
    count + updated + copied - 42
}
