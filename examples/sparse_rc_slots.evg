fn new_buffer<T>(capacity: usize) -> unique(T | shape(T), capacity)
where integer(capacity) * integer(size_of(T)) <= integer(isize::MAX) {
    alloc(capacity, shape(T))
}

fn main() -> usize {
    let buffer = new_buffer::<rc::Rc<unique(usize)>>(8);
    (*buffer)[3] = rc::new::<unique(usize)>(alloc(42));
    let value: rc::Rc<unique(usize)> = (*buffer)[3];
    let empty: unique(shape(rc::Rc<unique(usize)>), 8) = buffer;
    drop(empty);
    **value.value()
}
