type Ledger struct {count: usize, owners: usize} where (
    fact accurate = count == owners;
    fact zero_is_safe = count == 0 => owners == 0;
    accurate && zero_is_safe
);

fn pulse(slot: &usize)
    modifies(slot)
    ensures
        (*slot == 42)
{
    *slot = 0;
    *slot = 42;
}

fn main() -> usize {
    let owner = alloc(Ledger {count: 42, owners: 42});
    update(*owner) lifts accurate {
        pulse(&(*owner).count);
    }
    (*owner).count
}
