fn maximum(a: &usize, b: &usize) -> &usize
borrows(a) when *a >= *b else borrows(b)
ensures *result >= *a && *result >= *b {
    if *a >= *b {a} else {b}
}

fn forward(value: &usize) -> &usize borrows(value) {&*value}

fn main() -> usize ensures result == 42 {
    let left: usize = 7;
    let right: usize = 42;
    let selected = forward(maximum(&left, &right));
    // Changing the comparison's inputs does not reroute the saved pointer.
    left = 100;
    proof original_plane: selected == &right;
    *selected
}
