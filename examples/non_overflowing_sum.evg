type NonZero struct {data: usize} where self.data != 0;

impl NonZero {
    fn new(data: usize) -> Self
        where
            data != 0
        ensures
            result.data == data
    {
        Self {data: data}
    }

    method& add(other: &Self) -> Self
        where
            usize::non_overflowing_sum(self.data, other.data)
        ensures
            integer::from(result.data) == integer::from(self.data) + integer::from(other.data)
    {
        Self {data: self.data + other.data}
    }
}

fn main() -> usize {
    let first = NonZero::new(10);
    let second = NonZero::new(32);
    let sum = first.add(&second);
    proof _: sum.data == 42;
    // The primitive operation's overflow value is unspecified. This source
    // function deliberately promises a modular result and proves that policy.
    let wrapped = usize::wrapping_add(usize::MAX, 1);
    proof _: wrapped == 0;
    sum.data
}
