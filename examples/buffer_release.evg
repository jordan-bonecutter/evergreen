// Exercise the source-defined owning Vec storage.
fn main() -> usize {
    let values = vec::Vec::<unique(usize)>::new(0);
    values = values.reallocate(8);
    values.push(alloc(42));
    let item = values.pop();
    let answer = *item;
    values = values.release_empty();
    proof empty: values.length() == 0 && values.capacity() == 0;
    drop(values);
    answer
}
