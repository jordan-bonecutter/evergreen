// These source definitions become explicit formulas under the universal binder.
ideal fn affine(n: integer) -> integer {
    3 * n + 2
}

ideal fn nonnegative(n: integer) -> bool {
    n >= 0
}

fn check_byte(byte: u8) {
    proof bounds:
        forall(i: integer)
        where (
            nonnegative(i)
        ) {affine(i) + integer::from(byte) >= 2} by {
            intro i;
            omega
        };

        // Specialization retains the definition and the captured byte's revision.
    proof selected:
        affine(7) + integer::from(byte) >= 2 by {
            specialize bounds(7);
            omega
        };
}

fn main() -> usize {
    check_byte(42);
    42
}
