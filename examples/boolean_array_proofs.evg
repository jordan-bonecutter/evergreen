fn main() -> usize
    ensures
        result == 42
{
    let source: [bool; 4] = [false, true, false, true];
    let target: [bool; 5] = [true, false, true, false, true];
    arrays::copy_range(&source, &target, 1, 3);
    proof _: target[0] && target[1] && !target[2] && !target[3] && target[4];

    source[1] = false;
    proof _: target[1];
    arrays::fill_range(&target, 3, 5, !target[2] && source[1]);
    proof _: target[0] && target[1] && !target[2] && !target[3] && !target[4];
    if target[1] {42} else {1}
}
