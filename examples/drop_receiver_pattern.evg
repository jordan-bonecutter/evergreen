type Child struct {finished: &bool}
impl Drop for Child {
    fn drop(self)
        modifies(self.finished)
        ensures
            (*self.finished)
    {
        *self.finished = true;
    }
}

type Resource struct {data: unique(usize), child: Child} where (*data == 42);
impl Drop for Resource {
    fn drop(self)
        modifies(self.child.finished)
        ensures
            (*self.child.finished)
    {
        let payload = &*self.data;
        let Resource {data, child} = self;
        // Moving the pointer into a local does not move its allocation.
        proof payload_survives: *payload == 42;
        proof local_owner_is_valid: *data == 42;
        // Child and data are cleaned up once as locals, in reverse order.
    }
}

fn main() -> usize
    ensures
        (result == 42)
{
    let finished = false;
    let resource = Resource {
        data: alloc(42),
        child: Child {finished: &finished}
    };
    drop(resource);
    proof child_ran: finished;
    if finished {42} else {0}
}
