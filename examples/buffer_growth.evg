// Exercise the source-defined owning storage used for Vec migration.
fn main() -> usize {
    let values = vec::Buffer::<unique(usize)>::new(8);
    values.push(alloc(7));
    values.push(alloc(42));
    values = values.reallocate(8);
    let item = values.pop();
    let answer = *item;
    drop(values);
    answer
}
