// Parameters are universally quantified; this is not testing example inputs.
fn increment(n: nat) -> nat
ensures (result > n) {
    fact successor_grows = n + 1 > n by { omega };
    n + 1
} proof { omega }

fn bounded_index(n: nat, data: [int; n], index: nat) -> int
where (index < n) {
    data[index]
}

fn main() -> nat ensures (result == 42) {
    let answer: nat = 40 + 2;
    answer
} proof { rfl }
