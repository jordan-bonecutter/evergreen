type Ledger struct {count: &usize, owners: usize} where (
    fact accurate = *count == owners;
    fact zero_is_safe = *count == 0 => owners == 0;
    accurate && zero_is_safe
);

fn pulse(slot: &usize) modifies(slot) ensures(*slot == 42) {
    *slot = 0;
    *slot = 42;
}

fn main() {
    let count: usize = 42;
    let ledger = Ledger {count: &count, owners: 42};
    // Its final state is valid, but the first store breaks zero_is_safe.
    update(ledger) lifts accurate {
        pulse(ledger.count);
    }
}
