// A helper can drop an Rc without knowing whether the caller has other handles.
fn discard(value: rc::Rc) {}

fn main() -> usize {
    let first = rc::new(42);
    let view = first.value();
    let second = first.clone();
    {
        let third = second.clone();
        proof three: first.strong_count() == 3;
    };
    proof two: first.strong_count() == 2;
    let two_remain = first.strong_count() == 2;
    discard(second);
    proof unique: first.strong_count() == 1;
    if two_remain && first.strong_count() == 1 {*view} else {1}
}
