fn read(value: &usize) -> usize ensures (result == *value) {
    *value
}

fn main() -> usize ensures (result == 42) {
    let data: [usize; 2] = [1, 2];
    // Mutable aliases are allowed, including references into the same array.
    let first = &data[0];
    let second = &data[1];
    *first = 40;
    *second = 42;
    read(second)
}
