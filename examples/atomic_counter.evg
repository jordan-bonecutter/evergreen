// Check/run/build after x86_64_atomics.evg and atomic_counter.evg.
fn main() -> usize {
    let count: usize = 41;
    let increased = atomic_counter::try_increment(&count);
    proof incremented: increased && count == 42;
    let previous = atomic_counter::decrement(&count);
    proof decremented: previous == 42 && count == 41;

    let saturated: usize = usize::MAX;
    let overflowed = atomic_counter::try_increment(&saturated);
    proof no_wrap: !overflowed && saturated == usize::MAX;

    let empty: usize = 0;
    let absent = atomic_counter::decrement(&empty);
    proof no_underflow: absent == 0 && empty == 0;

    let final: usize = 1;
    let last = atomic_counter::decrement(&final);
    proof final_release: last == 1 && final == 0;

    let near_limit: usize = usize::MAX - 1;
    let reached_limit = atomic_counter::try_increment(&near_limit);
    proof largest_increment: reached_limit && near_limit == usize::MAX;
    let largest_old = atomic_counter::decrement(&near_limit);
    proof largest_decrement: largest_old == usize::MAX && near_limit == usize::MAX - 1;

    let started_empty: usize = 0;
    let acquired_first = atomic_counter::try_increment(&started_empty);
    proof first_increment: acquired_first && started_empty == 1;

    if increased && !overflowed && previous == 42 && absent == 0 && last == 1 {42} else {1}
}
