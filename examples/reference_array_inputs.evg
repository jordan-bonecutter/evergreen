type View struct {target: &usize}
fn set_second(
    views: &[View; 2],
    value: usize
)
    modifies((*views)[1].target)
    ensures
        (
            *(*views)[1].target == value &&
            *(*views)[0].target == old(*(*views)[0].target)
        )
{
    *(*views)[1].target = value;
}

fn second(
    views: &[View; 2]
) -> &usize
    borrows((*views)[1].target)
{
    (*views)[1].target
}

fn main() -> usize
    ensures
        (result == 42)
{
    let first: usize = 7;
    let last: usize = 0;
    let views: [View; 2] = [View {target: &first}, View {target: &last}];
    let target = second(&views);
    set_second(&views, 42);
    proof first_unchanged: first == 7;
    *target
}
