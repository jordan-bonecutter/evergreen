// Reallocate a move-only prefix, then consume both elements and free the buffer.
fn finish(
    capacity: usize,
    grown: unique(unique(usize) | shape(unique(usize)), capacity)
) -> usize
    where
        2 <= capacity &&
        (
            forall(i: integer)
            where (
                0 <= i &&
                i < 2 &&
                i < integer::from(capacity)
            ) {typeof((*grown)[i]) == unique(usize)}
        ) &&
        (
            forall(i: integer)
            where (
                0 <= i &&
                2 <= i &&
                i < integer::from(capacity)
            ) {typeof((*grown)[i]) == shape(unique(usize))}
        )
{
    proof vacant:
        forall(i: integer)
        where (
            0 <= i &&
            2 <= i &&
            i < integer::from(capacity)
        ) {typeof((*grown)[i]) == shape(unique(usize))} by {assumption};
    let first_view: &unique(usize) = &(*grown)[0];
    let last: unique(usize) = move((*grown)[1]);
    let first: unique(usize) = move((*grown)[0]);
    proof frame:
        (
            forall(i: integer)
            where (
                0 <= i &&
                2 <= i &&
                i < integer::from(capacity)
            ) {typeof(old(*grown)[i]) == shape(unique(usize))}
        ) =>
        (
            forall(i: integer)
            where (
                0 <= i &&
                i < integer::from(capacity)
            ) {typeof((*grown)[i]) == shape(unique(usize))}
        ) by {
            intro previous;
            intro i;
            omega
        };
    proof empty:
        forall(i: integer)
        where (
            0 <= i &&
            i < integer::from(capacity)
        ) {typeof((*grown)[i]) == shape(unique(usize))} by {
            apply frame;
            exact vacant
        };
    arrays::release_empty::<unique(usize)>(capacity, grown);
    *last
}
fn main() -> usize {
    let data: unique(unique(usize) | shape(unique(usize)), 8) = alloc(8, shape(unique(usize)));
    (*data)[0] = alloc(7);
    (*data)[1] = alloc(42);
    let grown = arrays::relocate_prefix::<unique(usize)>(8, data, 2, 16);
    finish(16, grown)
}
