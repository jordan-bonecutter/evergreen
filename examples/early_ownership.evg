// A shared-pointer copy can start its lifetime at an earlier marked write.
// The compiler counts that owner immediately and requires a later real copy.
type Data struct {count: usize, value: usize}

fn main() -> usize {
    let first: shared(Data) = alloc(Data {count: 1, value: 42});
    first.count = first.count + 1 starts_owner(first);
    proof accurate_before_copy: nat(first.count) == owner_count(first);

    let second = first;
    proof accurate_after_copy: nat(first.count) == owner_count(first) by {exact accurate_before_copy};
    proof exactly_two: owner_count(first) == 2;

    // Ending an existing lifetime still requires consuming its actual pointer.
    first.count = first.count - 1;
    leak(first);
    proof sole_owner: owner_count(second) == 1;
    let last: unique(Data) = move(second);
    last.value
}
