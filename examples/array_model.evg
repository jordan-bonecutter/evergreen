    let actual_15 = scenario(true, 1, 1, 1);
    let failed_15: usize = if actual_15 == 13 {0} else {1};
    42 - (failed_0 + failed_1 + failed_2 + failed_3 + failed_4 + failed_5 + failed_6 + failed_7 + failed_8 + failed_9 + failed_10 + failed_11 + failed_12 + failed_13 + failed_14 + failed_15)
