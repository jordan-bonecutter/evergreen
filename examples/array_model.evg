fn put(data: &[usize; 2], mirror: &[usize; 2], index: usize, value: usize)
where(index < 2) modifies(&(*data)[index])
ensures((*data)[index] == value) {(*data)[index] = value;}
fn scenario(flag: bool, first: usize, second: usize, queried: usize) -> usize
where(first < 2 && second < 2 && queried < 2)
ensures(result == (if flag && second == queried {13} else {if first == queried {42} else {if queried == 0 {7} else {9}}})) {
    let data: [usize; 2] = [7, 9];
    let chosen = &data[queried];
    data[first] = 42;
    let guarded = if flag {data[queried]} else {0};
    let effect = if flag {put(&data, &data, second, 13)} else {()};
    *chosen
}
fn main() -> usize ensures(result == 42) {
