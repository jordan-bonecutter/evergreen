    let actual_10 = scenario(false, 1, 0, 1);
    let failed_10: usize = if actual_10 == 42 {0} else {1};
    let actual_11 = scenario(true, 1, 0, 1);
    let failed_11: usize = if actual_11 == 42 {0} else {1};
    let actual_12 = scenario(false, 1, 1, 0);
