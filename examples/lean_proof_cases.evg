ideal fn commute(a: bool, b: bool) -> nat ensures(result == 42) {
    proof explosion: false => a by {intro impossible; cases impossible};
    proof disjunction: (a || b) => (b || a) by {
        intro either;
        cases either with first | second;
        right;
        exact first;
        left;
        exact second
    };
    proof conjunction: (a && b) => (b && a) by {
        intro both;
        cases both with first, second;
        constructor;
        exact second;
        exact first
    };
    42
}

ideal fn reuse_names(a: bool, b: bool) -> nat {
    proof same: (a || b) => (a || b) by {
        intro either;
        cases either with part | part;
        left;
        exact part;
        right;
        exact part
    };
    42
}

ideal fn main() -> nat ensures(result == 42) {
    42
}
