type Resource struct {value: usize} where(value == 42);
impl Drop for Resource {fn drop(self) {proof valid: self.value == 42;}}

fn make(value: usize) -> unique(usize) ensures(*result == value) {alloc(value)}

fn forward(owner: unique(usize)) -> unique(usize)
ensures(*result == *owner) {owner}

fn read(owner: &unique(usize)) -> usize ensures(result == **owner) {**owner}

fn borrow(owner: &unique(usize)) -> &usize borrows(&**owner) {&**owner}

fn set(owner: &unique(usize), value: usize)
modifies(&**owner) ensures(**owner == value) {**owner = value;}

fn advance(owner: unique(usize)) -> unique(usize)
where(*owner < usize::MAX)
ensures(*result == old(*owner) + 1) {
    *owner = *owner + 1;
    owner
}

fn main() -> usize ensures(result == 42) {
    let owner = make(41);
    let view = &*owner;
    let moved = advance(forward(owner));
    proof same_plane: view == &*moved;
    set(&moved, 42);
    proof updated: *view == 42;
    let borrowed = borrow(&moved);
    proof still_same: borrowed == view;
    let resource: unique(Resource) = alloc(Resource {value: 42});
    let nested: unique(unique(Resource)) = alloc(resource);
    let replace: unique(usize) = alloc(41);
    let slot = &replace;
    replace = alloc(42);
    proof slot_unchanged: **slot == 42;
    read(&moved)
}
