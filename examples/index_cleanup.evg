type Reset struct {target: &usize, ready: bool}

impl Drop for Reset {
    fn drop(self)
    modifies(self.target)
    ensures(*self.target == 41) {
        *self.target = 41;
    }
}

fn main() -> usize {
    let data: [usize; 1] = [usize::MAX];
    // The condition's temporary is dropped before selecting the array element.
    let value = data[if (Reset {target: &data[0], ready: true}).ready {0} else {0}];
    proof current: value == 41;
    value + 1
}
