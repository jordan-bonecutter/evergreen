module lexer;

// Initial token categories: EOF=0, identifier=1, integer=2, punctuation=3,
// whitespace=4, unsupported byte=5, line comment=6. Named variants will replace these codes.
// Tokens refer to byte ranges; they do not copy or own the source text.
type Token struct {kind: u8, start: usize, end: usize} where self.kind <= 6 && self.start <= self.end;

impl Copy for Token {}

fn identifier_start(byte: u8) -> bool {
    (65 <= byte && byte <= 90) || (97 <= byte && byte <= 122) || byte == 95
}

fn digit(byte: u8) -> bool {
    48 <= byte && byte <= 57
}

fn whitespace(byte: u8) -> bool {
    match byte {9 => true, 10 => true, 13 => true, 32 => true, _ => false,}
}

fn punctuation(byte: u8) -> bool {
    (40 <= byte && byte <= 47) || // ()*+,-./
    (58 <= byte && byte <= 62) || // :;<=>
    (123 <= byte && byte <= 125) || // {|}
    byte == 33 || byte == 37 || byte == 38 || byte == 91 || byte == 93
}

fn continues(kind: u8, byte: u8) -> bool {
    match kind {
        1 => identifier_start(byte) || digit(byte),
        2 => digit(byte),
        4 => whitespace(byte),
        6 => byte != 10, // Preserve the newline as a separate whitespace token.
        _ => false,
    }
}

fn operator_pair(first: u8, second: u8) -> bool {
    match first {
        45 => second == 62, // ->
        60 => second == 61, // <=
        62 => second == 61, // >=
        61 => second == 61 || second == 62, // == or =>
        33 => second == 61, // !=
        38 => second == 38, // &&
        124 => second == 124, // ||
        58 => second == 58, // ::
        _ => false,
    }
}

fn punctuation_pair_end(
    length: usize,
    source: &[u8; length],
    position: usize
) -> usize
    where
        position < length
    ensures
        position < result &&
        result <= length
{
    if length - position >= 2 {
        if operator_pair((*source)[position], (*source)[position + 1]) {position + 2} else {position + 1}
    } else {position + 1}
}

fn punctuation_end(
    length: usize,
    source: &[u8; length],
    position: usize
) -> usize
    where
        position < length
    ensures
        position < result &&
        result <= length
{
    // Match <=> before <=. Establish the bound before evaluating lookahead.
    if length - position >= 3 {
        if (*source)[position] == 60 && (*source)[position + 1] == 61 && (*source)[position + 2] == 62 {position + 3} else {punctuation_pair_end(length, source, position)}
    } else {punctuation_pair_end(length, source, position)}
}

fn starts_comment(
    length: usize,
    source: &[u8; length],
    position: usize
) -> bool
    where
        position < length
{
    if length - position >= 2 {(*source)[position] == 47 && (*source)[position + 1] == 47} else {false}
}

// Every non-EOF result makes progress. Array accesses are statically bounded;
// unsupported bytes produce a one-byte error token rather than being skipped.
fn next(
    length: usize,
    source: &[u8; length],
    position: usize
) -> Token
    where
        position <= length
    ensures
        result.start == position &&
        result.end <= length &&
        (position == length =>
        result.kind == 0 &&
        result.end == position) &&
        (position < length =>
        result.kind != 0 &&
        position < result.end)
{
    if position == length {
        Token {kind: 0, start: position, end: position}
    } else {
        let byte = (*source)[position];
        let kind: u8 = if identifier_start(byte) {1} else {
            if digit(byte) {2} else {
                if whitespace(byte) {4} else {
                    if starts_comment(length, source, position) {6} else {
                        if punctuation(byte) {3} else {5}
                    }
                }
            }
        };
        let end = if kind == 3 {punctuation_end(length, source, position)} else {position + 1};
        let scanning = true;
        while end < length && scanning
            invariant
                position < end &&
                end <= length
            modifies(&end, &scanning)
            decreases(if scanning {integer::from(length) - integer::from(end) + 1} else {0})
        {
            if continues(kind, (*source)[end]) {
                end = end + 1;
            } else {
                scanning = false;
            }
        }
        Token {kind: kind, start: position, end: end}
    }
}

fn tokenize(
    length: usize,
    source: &[u8; length]
) -> vec::Vec<Token>
    where
        integer::from(length) * integer::from(size_of(Token)) <= integer::from(isize::MAX)
    ensures
        result.length() <= length
{
    let tokens = vec::Vec::<Token>::new(length);
    let position: usize = 0;
    while position < length
        invariant
            position <= length &&
            tokens.length() <= position &&
            tokens.capacity() == length
        modifies(&tokens, &position)
        decreases(length - position)
    {
        let token = next(length, source, position);
        tokens.push(token);
        position = token.end;
    }
    tokens
}
