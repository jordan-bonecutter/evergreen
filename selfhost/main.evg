import lexer;

fn expected_operator(index: usize, kind: u8, end: usize) -> bool {
    match index {
        0 => kind == 1 && end == 1,
        1 => kind == 3 && end == 3,
        2 => kind == 1 && end == 4,
        3 => kind == 4 && end == 5,
        4 => kind == 3 && end == 7,
        5 => kind == 4 && end == 8,
        6 => kind == 1 && end == 9,
        7 => kind == 4 && end == 10,
        8 => kind == 3 && end == 13,
        9 => kind == 4 && end == 14,
        10 => kind == 1 && end == 15,
        11 => kind == 4 && end == 16,
        12 => kind == 3 && end == 18,
        13 => kind == 4 && end == 19,
        14 => kind == 3 && end == 21,
        15 => kind == 4 && end == 22,
        16 => kind == 3 && end == 24,
        17 => kind == 4 && end == 25,
        18 => kind == 3 && end == 27,
        19 => kind == 4 && end == 28,
        20 => kind == 3 && end == 30,
        21 => kind == 4 && end == 31,
        22 => kind == 3 && end == 33,
        23 => kind == 4 && end == 34,
        24 => kind == 3 && end == 36,
        25 => kind == 4 && end == 37,
        26 => kind == 3 && end == 38,
        _ => false,
    }
}

fn expected(index: usize, kind: u8, end: usize) -> bool {
    if index < 27 {expected_operator(index, kind, end)} else {
        match index {
            27 => kind == 4 && end == 39,
            28 => kind == 6 && end == 48,
            29 => kind == 4 && end == 49,
            30 => kind == 3 && end == 50,
            31 => kind == 4 && end == 51,
            32 => kind == 6 && end == 57,
            _ => false,
        }
    }
}

fn strings() -> bool {
    let empty: [u8; 2] = [34, 34];
    let escaped_quote: [u8; 6] = [34, 97, 92, 34, 98, 34];
    let escaped_slash: [u8; 4] = [34, 92, 92, 34];
    let incomplete: [u8; 3] = [34, 97, 92];
    let multiline: [u8; 3] = [34, 10, 34];
    let a = lexer::next(2, &empty, 0);
    let b = lexer::next(6, &escaped_quote, 0);
    let c = lexer::next(4, &escaped_slash, 0);
    let d = lexer::next(3, &incomplete, 0);
    let e = lexer::next(3, &multiline, 0);
    a.kind == 7 && a.end == 2 && b.kind == 7 && b.end == 6 && c.kind == 7 && c.end == 4 && d.kind == 5 && d.end == 3 && e.kind == 7 && e.end == 3
}

// Operators, comments ending at newline/EOF, and a standalone slash.
// This entry point is a bootstrap smoke test, not a compiler yet.
fn main() -> usize {
    let source: [u8; 57] = [
        97,
        58,
        58,
        98,
        32,
        61,
        62,
        32,
        99,
        32,
        60,
        61,
        62,
        32,
        100,
        32,
        60,
        61,
        32,
        62,
        61,
        32,
        61,
        61,
        32,
        33,
        61,
        32,
        38,
        38,
        32,
        124,
        124,
        32,
        45,
        62,
        32,
        60,
        32,
        47,
        47,
        105,
        103,
        110,
        111,
        114,
        101,
        100,
        10,
        47,
        32,
        47,
        47,
        116,
        97,
        105,
        108
    ];
    let valid = true;
    let position: usize = 0;
    let count: usize = 0;
    while position < 57
        invariant
            count <= position &&
            position <= 57
        modifies(&position, &count, &valid)
        decreases(57 - position)
    {
        let token = lexer::next(57, &source, position);
        valid = valid && expected(count, token.kind, token.end);
        count = count + 1;
        position = token.end;
    }
    if valid && count == 33 && strings() {42} else {1}
}
