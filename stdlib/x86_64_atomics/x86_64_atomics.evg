// One target operation with an explicit trusted instruction contract.
// This is not Arc, a thread API, or a proof of the hardware memory model.
module x86_64_atomics;
extern compare_exchange64 fn compare_exchange(value: &usize, expected: usize, desired: usize) -> usize
    modifies(value)
    ensures
        (
            result == old(*value) &&
            (old(*value) == expected =>
            *value == desired) &&
            (old(*value) != expected =>
            *value == old(*value))
        )
;
proof {trustme}
