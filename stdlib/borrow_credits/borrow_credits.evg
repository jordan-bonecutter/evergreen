// Check after credits.evg. Conserved proof quantities attached to live borrows.
// This grants no allocation, deallocation, or reference-count ownership authority.
// Kept as a generic proof-resource regression library; Rc uses the owner census.
module borrow_credits;
ideal opaque type Token struct {budget: credits::Credit, target: &usize}
ideal type Split struct {left: Token, right: Token}

ideal fn units(token: &Token) -> nat
ensures(result == credits::units(&(*token).budget)) {
    credits::units(&(*token).budget)
}

ideal fn target(token: &Token) -> &usize
borrows((*token).target) {(*token).target}

ideal fn bind(budget: credits::Credit, target: &usize) -> Token
borrows(target: target)
ensures(units(&result) == credits::units(&budget)) {
    Token {budget: budget, target: target}
}

// Forward a write to an opaque credit region without knowing its fields.
// The target pointer is outside that footprint and remains unchanged.
ideal fn take(token: &Token, amount: nat) -> Token
where(amount <= units(token))
modifies(&(*token).budget)
borrows(target: (*token).target)
ensures(units(&result) == amount
    && units(token) + units(&result) == old(units(token))) {
    Token {
        budget: credits::take(&(*token).budget, amount),
        target: (*token).target
    }
}

ideal fn split(token: Token, amount: nat) -> Split
where(amount <= units(&token))
borrows(left.target: token.target, right.target: token.target)
ensures(units(&result.left) == amount
    && units(&result.left) + units(&result.right) == units(&token)) {
    let Token {budget, target} = token;
    let credits::Split {left, right} = credits::split(budget, amount);
    Split {
        left: Token {budget: left, target: target},
        right: Token {budget: right, target: target}
    }
}

ideal fn join(left: Token, right: Token) -> Token
where(target(&left) == target(&right))
borrows(target: left.target)
ensures(units(&result) == units(&left) + units(&right)) {
    let Token {budget: a, target: first} = left;
    let Token {budget: b, target: second} = right;
    Token {budget: credits::join(a, b), target: first}
}
