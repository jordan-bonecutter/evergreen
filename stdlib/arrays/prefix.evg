module arrays;

// Extract one value; the remaining prefix stays live and the suffix is vacant.
fn take_last<T>(
    capacity: usize,
    data: &[T | shape(T); capacity],
    length: usize
) -> T
    where
        0 < length &&
        length <= capacity &&
        arrays::initialized_prefix::<T>(data, integer::from(length)) &&
        arrays::vacant_suffix::<T>(data, integer::from(length))
    modifies(&(*data)[length - 1])
    ensures
        arrays::initialized_prefix::<T>(data, integer::from(length) - 1) &&
        arrays::vacant_suffix::<T>(data, integer::from(length) - 1)
{
    proof initialized:
        arrays::initialized_prefix::<T>(data, integer::from(length)) by {assumption};
    proof vacant:
        arrays::vacant_suffix::<T>(data, integer::from(length)) by {assumption};
    let value: T = move((*data)[length - 1]);
    proof frame:
        old(arrays::initialized_prefix::<T>(data, integer::from(length))) =>
        arrays::initialized_prefix::<T>(data, integer::from(length) - 1) by {
            intro prior;
            intro i;
            omega
        };
    proof prefix:
        arrays::initialized_prefix::<T>(data, integer::from(length) - 1) by {
            apply frame;
            exact initialized
        };
    proof empty_frame:
        old(arrays::vacant_suffix::<T>(data, integer::from(length))) =>
        arrays::vacant_suffix::<T>(data, integer::from(length) - 1) by {
            intro prior;
            intro i;
            omega
        };
    proof suffix:
        arrays::vacant_suffix::<T>(data, integer::from(length) - 1) by {
            apply empty_frame;
            exact vacant
        };
    value
}

// Initialize the preceding slot of a live interval. The rest stays vacant.
fn prepend<T>(
    capacity: usize,
    data: &[T | shape(T); capacity],
    start: usize,
    end: usize,
    value: T
)
    where
        0 < start &&
        start <= end &&
        end <= capacity &&
        (
            arrays::initialized_range::<T>(data, integer::from(start), integer::from(end))
        ) &&
        (
            arrays::vacant_outside::<T>(data, integer::from(start), integer::from(end))
        )
    modifies(&(*data)[start - 1])
    ensures
        (
            arrays::initialized_range::<T>(data, integer::from(start) - 1, integer::from(end))
        ) &&
        (
            arrays::vacant_outside::<T>(data, integer::from(start) - 1, integer::from(end))
        )
{
    proof prior:
        arrays::initialized_range::<T>(data, integer::from(start), integer::from(end)) by {assumption};
    proof vacant:
        arrays::vacant_outside::<T>(data, integer::from(start), integer::from(end)) by {assumption};
    (*data)[start - 1] = value;
    proof extend:
        (
            old(
                arrays::initialized_range::<T>(data, integer::from(start), integer::from(end))
            )
        ) =>
        (
            arrays::initialized_range::<T>(data, integer::from(start) - 1, integer::from(end))
        ) by {
            intro previous;
            intro i;
            omega
        };
    proof live:
        arrays::initialized_range::<T>(data, integer::from(start) - 1, integer::from(end)) by {
            apply extend;
            exact prior
        };
    proof frame:
        (
            start <= end &&
            (
                old(
                    arrays::vacant_outside::<T>(data, integer::from(start), integer::from(end))
                )
            )
        ) =>
        (
            arrays::vacant_outside::<T>(data, integer::from(start) - 1, integer::from(end))
        ) by {
            intro premise;
            cases premise with ordered,
            previous;
            intro i;
            omega
        };
    proof rest:
        arrays::vacant_outside::<T>(data, integer::from(start) - 1, integer::from(end)) by {
            apply frame;
            constructor;
            omega;
            exact vacant
        };
}
// Transfer an initialized prefix into fresh storage, then release the old buffer.
// Payloads are moved once; this function never duplicates or drops a live element.
fn relocate_prefix<T>(
    capacity: usize,
    data: unique(T | shape(T), capacity),
    length: usize,
    new_capacity: usize
) -> unique(T | shape(T), new_capacity)
    where
        0 < new_capacity &&
        length <= capacity &&
        length <= new_capacity &&
        integer::from(new_capacity) * integer::from(size_of(T)) <= integer::from(isize::MAX) &&
        (arrays::initialized_prefix::<T>(&*data, integer::from(length))) &&
        (arrays::vacant_suffix::<T>(&*data, integer::from(length)))
    ensures
        (arrays::initialized_prefix::<T>(&*result, integer::from(length))) &&
        (arrays::vacant_suffix::<T>(&*result, integer::from(length)))
{
    let target: unique(T | shape(T), new_capacity) = alloc(new_capacity, shape(T));
    let remaining = length;
    proof initial_live:
        arrays::initialized_range::<T>(&*target, integer::from(remaining), integer::from(length)) by {
            intro i;
            omega
        };
    proof initial_empty:
        arrays::vacant_outside::<T>(&*target, integer::from(remaining), integer::from(length)) by {
            intro i;
            omega
        };
    while remaining > 0
        invariant
            remaining <= length &&
            length <= capacity &&
            length <= new_capacity &&
            (arrays::initialized_prefix::<T>(&*data, integer::from(remaining))) &&
            (arrays::vacant_suffix::<T>(&*data, integer::from(remaining))) &&
            (
                arrays::initialized_range::<T>(&*target, integer::from(remaining), integer::from(length))
            ) &&
            (
                arrays::vacant_outside::<T>(&*target, integer::from(remaining), integer::from(length))
            )
        modifies(&*data, &*target, &remaining)
        decreases remaining
    {
        let value = take_last::<T>(capacity, &*data, remaining);
        prepend::<T>(new_capacity, &*target, remaining, length, value);
        remaining = remaining - 1;
    }
    proof before_empty:
        arrays::vacant_suffix::<T>(&*data, integer::from(remaining)) by {assumption};
    proof finish_empty:
        (
            remaining == 0 &&
            (arrays::vacant_suffix::<T>(&*data, integer::from(remaining)))
        ) =>
        (arrays::vacant_suffix::<T>(&*data, 0)) by {
            intro premise;
            cases premise with done,
            all;
            intro i;
            specialize all(i);
            omega
        };
    proof empty:
        arrays::vacant_suffix::<T>(&*data, 0) by {
            apply finish_empty;
            constructor;
            omega;
            exact before_empty
        };
    proof before_live:
        arrays::initialized_range::<T>(&*target, integer::from(remaining), integer::from(length)) by {assumption};
    proof finish_live:
        (
            remaining == 0 &&
            (
                arrays::initialized_range::<T>(&*target, integer::from(remaining), integer::from(length))
            )
        ) =>
        (arrays::initialized_prefix::<T>(&*target, integer::from(length))) by {
            intro premise;
            cases premise with done,
            all;
            intro i;
            specialize all(i);
            omega
        };
    proof live:
        arrays::initialized_prefix::<T>(&*target, integer::from(length)) by {
            apply finish_live;
            constructor;
            omega;
            exact before_live
        };
    proof before_rest:
        arrays::vacant_outside::<T>(&*target, integer::from(remaining), integer::from(length)) by {assumption};
    proof finish_rest:
        (
            remaining == 0 &&
            (
                arrays::vacant_outside::<T>(&*target, integer::from(remaining), integer::from(length))
            )
        ) =>
        (arrays::vacant_suffix::<T>(&*target, integer::from(length))) by {
            intro premise;
            cases premise with done,
            all;
            intro i;
            specialize all(i);
            omega
        };
    proof rest:
        arrays::vacant_suffix::<T>(&*target, integer::from(length)) by {
            apply finish_rest;
            constructor;
            omega;
            exact before_rest
        };
    arrays::release_empty::<T>(data);
    target
}
