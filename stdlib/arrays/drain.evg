module arrays;

// Drop the removed suffix, retaining allocation and the requested live prefix.
fn truncate_prefix<T>(
    capacity: usize,
    data: unique(T | shape(T), capacity),
    length: usize,
    kept: usize
) -> unique(T | shape(T), capacity)
    where
        kept <= length &&
        length <= capacity &&
        arrays::initialized_prefix::<T>(&*data, integer::from(length)) &&
        arrays::vacant_suffix::<T>(&*data, integer::from(length))
    ensures
        arrays::initialized_prefix::<T>(&*result, integer::from(kept)) &&
        arrays::vacant_suffix::<T>(&*result, integer::from(kept))
{
    let remaining = length;
    while remaining > kept
        invariant
            kept <= remaining &&
            remaining <= capacity &&
            arrays::initialized_prefix::<T>(&*data, integer::from(remaining)) &&
            arrays::vacant_suffix::<T>(&*data, integer::from(remaining))
        modifies(&*data, &remaining)
        decreases remaining
    {
        let value = arrays::take_last::<T>(capacity, &*data, remaining);
        drop(value);
        remaining = remaining - 1;
    }
    proof before_live:
        forall(i: integer)
        where (
            0 <= i &&
            i < integer::from(remaining) &&
            i < integer::from(capacity)
        ) {typeof((*data)[i]) == T} by {assumption};
    proof frame_live:
        (
            remaining == kept &&
            (
                forall(i: integer)
                where (
                    0 <= i &&
                    i < integer::from(remaining) &&
                    i < integer::from(capacity)
                ) {typeof((*data)[i]) == T}
            )
        ) =>
        (
            forall(i: integer)
            where (
                0 <= i &&
                i < integer::from(kept) &&
                i < integer::from(capacity)
            ) {typeof((*data)[i]) == T}
        ) by {
            intro premise;
            cases premise with done,
            range;
            intro i;
            specialize range(i);
            omega
        };
    proof after_live:
        forall(i: integer)
        where (
            0 <= i &&
            i < integer::from(kept) &&
            i < integer::from(capacity)
        ) {typeof((*data)[i]) == T} by {
            apply frame_live;
            constructor;
            omega;
            exact before_live
        };
    proof before_vacant:
        forall(i: integer)
        where (
            0 <= i &&
            integer::from(remaining) <= i &&
            i < integer::from(capacity)
        ) {typeof((*data)[i]) == shape(T)} by {assumption};
    proof frame_vacant:
        (
            remaining == kept &&
            (
                forall(i: integer)
                where (
                    0 <= i &&
                    integer::from(remaining) <= i &&
                    i < integer::from(capacity)
                ) {typeof((*data)[i]) == shape(T)}
            )
        ) =>
        (
            forall(i: integer)
            where (
                0 <= i &&
                integer::from(kept) <= i &&
                i < integer::from(capacity)
            ) {typeof((*data)[i]) == shape(T)}
        ) by {
            intro premise;
            cases premise with done,
            range;
            intro i;
            specialize range(i);
            omega
        };
    proof after_vacant:
        forall(i: integer)
        where (
            0 <= i &&
            integer::from(kept) <= i &&
            i < integer::from(capacity)
        ) {typeof((*data)[i]) == shape(T)} by {
            apply frame_vacant;
            constructor;
            omega;
            exact before_vacant
        };
    data
}

// Drop exactly the initialized prefix, then release the entirely vacant buffer.
fn drain_prefix<T>(capacity: usize, data: unique(T | shape(T), capacity), length: usize)
    where
        length <= capacity &&
        arrays::initialized_prefix::<T>(&*data, integer::from(length)) &&
        arrays::vacant_suffix::<T>(&*data, integer::from(length))
{
    let vacant = truncate_prefix::<T>(capacity, data, length, 0);
    arrays::release_empty::<T>(capacity, vacant);
}
