module arrays;

// Propositions about the in-bounds portion of a half-open interval.
ideal fn initialized_prefix<T>(
    ideal capacity: nat,
    data: &[T | shape(T); capacity],
    end: integer
) -> Fact {
    forall(i: integer)
    where (
        0 <= i &&
        i < end &&
        i < integer::from(capacity)
    ) {typeof((*data)[i]) == T}
}

ideal fn vacant_suffix<T>(
    ideal capacity: nat,
    data: &[T | shape(T); capacity],
    start: integer
) -> Fact {
    forall(i: integer)
    where (
        0 <= i &&
        start <= i &&
        i < integer::from(capacity)
    ) {typeof((*data)[i]) == shape(T)}
}

ideal fn initialized_range<T>(
    ideal capacity: nat,
    data: &[T | shape(T); capacity],
    start: integer,
    end: integer
) -> Fact {
    forall(i: integer)
    where (
        0 <= i &&
        start <= i &&
        i < end &&
        i < integer::from(capacity)
    ) {typeof((*data)[i]) == T}
}

ideal fn vacant_outside<T>(
    ideal capacity: nat,
    data: &[T | shape(T); capacity],
    start: integer,
    end: integer
) -> Fact {
    forall(i: integer)
    where (
        0 <= i &&
        (i < start || end <= i) &&
        i < integer::from(capacity)
    ) {typeof((*data)[i]) == shape(T)}
}
