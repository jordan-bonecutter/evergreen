// An owned vector of initialized elements. Capacity changes are explicit.
module vec;

opaque type Vec<T = usize> struct {cap: usize, len: usize, data: Null | unique(T, cap)} where (
    fact length_fits = len <= cap;
    fact storage_matches_capacity = (cap == 0) == (typeof(data) == Null);
    length_fits && storage_matches_capacity
);

fn allocate_buffer<T = usize>(capacity: usize, initial: T) -> unique(T, capacity)
    where
        (capacity > 0 &&
        integer(capacity) * integer(size_of(T)) <= integer(isize::MAX))
{
    alloc(capacity, initial)
}

fn discard_zero(value: Null) {}
fn discard_buffer<T>(ideal n: nat, value: unique(T, n)) {}
impl<T> Drop for Vec<T> {
    fn drop({cap, len, data}) {
        if cap == 0 {discard_zero(data)} else {discard_buffer::<T>(data)}
    }
}

fn copy_prefix<T = usize>(
    source_capacity: usize,
    source: linear_plane(T, source_capacity),
    target_capacity: usize,
    target: linear_plane(T, target_capacity),
    count: usize,
    index: usize
)
    where
        (index <= count &&
        count <= source_capacity &&
        count <= target_capacity)
    modifies(target)
{
    let cursor = index;
    while cursor < count
        invariant
            (cursor <= count &&
            count <= source_capacity &&
            count <= target_capacity)
        modifies(target, &cursor)
        decreases(count - cursor)
    {
        (*target)[cursor] = (*source)[cursor];
        cursor = cursor + 1;
    }
}

// The checked vector API lives on Vec; storage copying remains reusable.
impl<T> Vec<T> {
    // Initialize backing capacity while the logical vector remains empty.
    // Concrete instantiation must prove that duplicating initial is permitted.
    fn filled(capacity: usize, initial: T) -> Self
        where
            (integer(capacity) * integer(size_of(T)) <= integer(isize::MAX))
        ensures
            (result.len == 0 &&
            result.cap == capacity)
    {
        let data: Null | unique(T, capacity) = if capacity == 0 {0} else {allocate_buffer::<T>(capacity, initial)};
        Self {cap: capacity, len: 0, data: data}
    }

    fn new(capacity: usize) -> Self
        where
            (integer(capacity) * integer(size_of(T)) <= integer(isize::MAX))
        ensures
            (result.len == 0 &&
            result.cap == capacity)
    {
        Self::filled(capacity, 0)
    }

    method& length() -> usize
        ensures
            (result == self.len)
    {
        self.len
    }

    method& capacity() -> usize
        ensures
            (result == self.cap)
    {
        self.cap
    }

    method& get(index: usize) -> &T
        where
            (index < self.len)
        borrows(&(*self.data)[index])
    {
        &(*self.data)[index]
    }

    method& push(item: T)
        where
            (self.len < self.cap)
        modifies(&self.len, &(*self.data)[self.len])
        ensures
            (self.len == old(self.len) + 1 &&
            (*self.data)[old(self.len)] == item)
    {
        (*self.data)[self.len] = item;
        self.len = self.len + 1;
    }

    method& pop() -> T
        where
            (self.len > 0)
        modifies(&self.len)
        ensures
            (self.len + 1 == old(self.len) &&
            result == old((*self.data)[self.len - 1]))
    {
        let item = (*self.data)[self.len - 1];
        self.len = self.len - 1;
        item
    }

    // Return fresh storage; assignment releases the previous allocation and
    // invalidates references into that buffer.
    method& reallocate(new_capacity: usize) -> Self
        where
            (self.len <= new_capacity &&
            integer(new_capacity) * integer(size_of(T)) <= integer(isize::MAX))
        ensures
            (result.len == self.len &&
            result.cap == new_capacity)
    {
        self.reallocate_filled(new_capacity, 0)
    }

    method& reallocate_filled(new_capacity: usize, initial: T) -> Self
        where
            (self.len <= new_capacity &&
            integer(new_capacity) * integer(size_of(T)) <= integer(isize::MAX))
        ensures
            (result.len == self.len &&
            result.cap == new_capacity)
    {
        let grown = Self::filled(new_capacity, initial);
        if self.len == 0 {()} else {
            copy_prefix::<T>(self.cap, &*self.data, new_capacity, &*grown.data, self.len, 0)
        };
        grown.len = self.len;
        grown
    }

    // Complete consumption transfers the live allocation; an empty vector has
    // no allocated plane to return.
    method into_data() -> unique(T, self.cap)
        where
            self.cap > 0
    {
        let Vec::<T> {cap, len, data} = self;
        data
    }

}
