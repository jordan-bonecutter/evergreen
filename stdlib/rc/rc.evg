// Sequential counted ownership for a generic payload. Counter operations and
// the clone/release protocol are source code, not compiler-recognized behavior.
// Final/nonfinal release is selected by the checked source destructor.
module rc;

opaque type Data<T> struct {count: usize, value: T}

// An unpublished handle already owns its allocation-backed lifetime credit.
opaque type Credit<T> struct {data: shared(Data<T>)} where (nat(self.data.count) == owner_count(self.data));

opaque type Rc<T = usize> struct {data: shared(Data<T>)} where (
    fact reference_count_is_accurate = nat(self.data.count) == owner_count(self.data);
    fact zero_count_has_no_owners = self.data.count == 0 => owner_count(self.data) == 0;
    reference_count_is_accurate && zero_count_has_no_owners
);

fn new<T = usize>(value: T) -> Rc<T>
    ensures
        result.data.count == 1
{
    Rc::<T> {
        data: alloc(Data::<T> {count: 1, value: value})
    }
}

// The projected loans expose no Rc view whose accuracy fact could be used
// between these steps. The caller's complete invariant is restored at return.
fn reserve<T = usize>(allocation: &shared(Data<T>)) -> Credit<T>
    where
        allocation.count < usize::MAX &&
        nat(allocation.count) == owner_count(allocation)
    modifies(&allocation.count)
    ensures
        owner_count(result.data) == old(owner_count(allocation)) + 1 &&
        result.data.count == old(allocation.count) + 1 &&
        &*result.data == &**allocation
{
    allocation.count = allocation.count + 1;
    Credit::<T> {data: *allocation}
}

fn publish<T = usize>(credit: Credit<T>) -> Rc<T> {
    let Credit::<T> {data} = credit;
    Rc::<T> {data: move(data)}
}

impl<T> Drop for Rc<T> {
    fn drop({data})
        ensures
            if old(self.data.count) > 1 {
                nat((*old(self.data)).count) + 1 == nat(old(self.data.count)) &&
                owner_count(old(self.data)) + 1 == old(owner_count(self.data))
            } else {true}
    {
        if data.count == 1 {
            let allocation: unique(Data<T>) = move(data);
            drop(allocation);
        } else {
            data.count = data.count - 1;
            leak(data);
        }
    }
}

impl<T> Rc<T> {
    method& strong_count() -> usize
        ensures
            result == self.data.count
    {
        self.data.count
    }

    method& value() -> &T
        borrows(&self.data.value)
    {
        &self.data.value
    }

    method& clone() -> Self
        where
            self.data.count < usize::MAX
        modifies(&self.data.count)
        ensures
            result.data.count == old(self.data.count) + 1 &&
            owner_count(result.data) == old(owner_count(self.data)) + 1
    {
        let credit = reserve::<T>(&self.data);
        publish::<T>(credit)
    }

    method release_nonfinal()
        where
            self.data.count > 1
        ensures
            nat((*old(self.data)).count) + 1 == nat(old(self.data.count)) &&
            owner_count(old(self.data)) + 1 == old(owner_count(self.data))
    {
        let Self {data} = self;
        data.count = data.count - 1;
        leak(data);
    }

    method release_last()
        where
            self.data.count == 1
    {
        let Self {data} = self;
        let allocation: unique(Data<T>) = move(data);
        drop(allocation);
    }
}
