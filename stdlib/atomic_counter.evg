// Check after x86_64_atomics.evg. Ordinary Evergreen CAS loops; not Rc/Arc.
// Contracts below describe the current sequential checker. Concurrent use still
// needs a shared-invariant rule and an instruction/memory-model refinement.
module atomic_counter {
    fn increment_from(value: &usize, observed: usize) -> bool
    modifies(value)
    ensures(
        (result && nat(*value) == nat(old(*value)) + 1) ||
        (!result && *value == old(*value) && *value == usize::MAX)
    ) {
        let desired: usize = if observed == usize::MAX {observed} else {observed + 1};
        let actual = x86_64_atomics::compare_exchange(value, observed, desired);
        if actual == observed {observed != usize::MAX} else {
            increment_from(value, actual)
        }
    }

    // A failed attempt publishes no increment. Saturation never wraps to zero.
    fn try_increment(value: &usize) -> bool
    modifies(value)
    ensures(
        (result && nat(*value) == nat(old(*value)) + 1) ||
        (!result && *value == old(*value) && *value == usize::MAX)
    ) {
        increment_from(value, 0)
    }

    fn decrement_from(value: &usize, observed: usize) -> usize
    modifies(value)
    ensures(result == old(*value)
        && (result == 0 => *value == 0)
        && (result > 0 => nat(*value) + 1 == nat(result))) {
        let desired: usize = if observed == 0 {0} else {observed - 1};
        let actual = x86_64_atomics::compare_exchange(value, observed, desired);
        if actual == observed {actual} else {decrement_from(value, actual)}
    }

    // Return the old count, so the caller can distinguish the final decrement
    // from a separate (possibly stale under concurrency) observation of zero.
    fn decrement(value: &usize) -> usize
    modifies(value)
    ensures(result == old(*value)
        && (result == 0 => *value == 0)
        && (result > 0 => nat(*value) + 1 == nat(result))) {
        decrement_from(value, 0)
    }
}
