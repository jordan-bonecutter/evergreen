// The flag and raw-union storage are ordinary source-defined data.
module option;

type Option<T> struct {data: T | shape(T), ok: bool} where (
    fact occupancy = self.ok <=>
    typeof(self.data) == T;
    occupancy
);

impl<T> Drop for Option<T> {
    fn drop({data, ok}) {
        if ok {
            let value: T = data;
            drop(value);
        } else {
            let vacant: shape(T) = data;
        }
    }
}

impl<T> Option<T> {
    fn some(value: T) -> Self
        ensures
            result.ok
    {
        Self {data: value, ok: true}
    }

    fn none() -> Self
        ensures
            !result.ok
    {
        Self {data: shape(T), ok: false}
    }

    method& is_some() -> bool
        ensures
            result == self.ok
    {
        self.ok
    }

    method& get() -> &T
        where
            self.ok
        borrows(&self.data)
    {
        &self.data
    }

    method& take() -> Self
        modifies(&self.data, &self.ok)
        ensures
            !self.ok &&
            result.ok == old(self.ok)
    {
        if self.ok {
            let output: T | shape(T) = shape(T);
            update(*self) lifts occupancy {
                let value: T = move(self.data);
                output = value;
                self.ok = false;
            }
            Self {data: output, ok: true}
        } else {Self::none()}
    }

    method unwrap({data, ok}) -> T
        where
            self.ok
    {
        let value: T = data;
        value
    }

    method unwrap_or({data, ok}, fallback: T) -> T {
        if ok {
            let value: T = data;
            value
        } else {
            let vacant: shape(T) = data;
            fallback
        }
    }
}
