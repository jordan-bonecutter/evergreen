// Linux x86-64 external boundary. Raw bytes carry no text encoding assumption.
module linux_io;
extern syscall(1) fn write(
    fd: usize,
    bytes: linear_plane(u8, capacity),
    count: usize,
    ideal capacity: nat
) -> isize
where(int(count) <= int(capacity))
ensures(int(result) <= int(count));
proof {trustme}

fn write_byte(fd: usize, byte: &u8, count: usize) -> isize
where(count <= 1)
ensures(result <= 1) {
    let bytes: array(u8, 1) = [*byte];
    write(fd, &bytes, count)
}

fn stdout_byte(byte: &u8) -> bool {
    write_byte(1, byte, 1) == 1
}

// One write attempt. Preserve short counts and negative error codes.
fn print_bytes(length: usize, bytes: linear_plane(u8, length)) -> isize
ensures(int(result) <= int(length)) {
    write(1, bytes, length)
}
