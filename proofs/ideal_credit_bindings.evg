// Check after stdlib/credits/credits.evg. Existing credits are split in ideal local
// bindings and consumed by runtime signatures. No runtime credit value exists.
fn spend_credit(ideal credit: credits::Credit, value: usize) -> usize
    ensures
        (result == value)
{
    value
}

fn use_budget(ideal credit: credits::Credit, amount: usize) -> usize
    where
        (nat(amount) <= credits::units(&credit))
    ensures
        (result == amount)
{
    ideal let original = credits::units(&credit);
    ideal let parts = credits::split(credit, nat(amount));
    ideal let credits::Split {left, right} = parts;
    proof conserved:
        credits::units(&left) + credits::units(&right) == original;
    let value = spend_credit(left, amount);
    spend_credit(right, value)
}
