// Check after stdlib/credits/credits.evg. No credit is minted by this example.
// The footprint names the opaque resource, not its private representation.
ideal fn take_existing(credit: &credits::Credit, amount: nat) -> credits::Credit
where(amount <= credits::units(credit))
modifies(credit)
ensures(credits::units(&result) == amount
    && credits::units(credit) + credits::units(&result) == old(credits::units(credit))) {
    credits::take(credit, amount)
}

ideal fn transfer_existing(credit: credits::Credit) -> credits::Credit
where(credits::units(&credit) >= 1)
ensures(credits::units(&result) == credits::units(&credit)) {
    let original: nat = credits::units(&credit);
    let taken = take_existing(&credit, 1);
    proof transfer_conserves:
        credits::units(&credit) + credits::units(&taken) == original;
    proof one_transferred: credits::units(&taken) == 1;
    let restored = credits::join(credit, taken);
    proof total_restored: credits::units(&restored) == original;
    restored
}
